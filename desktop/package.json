{
  "name": "collection-down-desktop",
  "version": "1.0.0",
  "description": "Desktop distribution of Collection Down",
  "author": "heartalborada-del",
  "license": "MIT",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dist": "electron-builder --projectDir .",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },
  "resolutions": {
    "tar": "^7.5.22"
  },
  "build": {
    "appId": "top.griseo.collection-down",
    "productName": "Collection Down",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.output",
        "to": ".output"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "executableName": "collection-down",
      "target": [
        "portable"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  }
}
